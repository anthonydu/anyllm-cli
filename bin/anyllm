#!/usr/bin/env bash

# Config location (XDG or fallback)
LEGACY_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gemini-cli"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/anyllm-cli"

# Migrate legacy config directory
if [[ -d "$LEGACY_CONFIG_DIR" ]]; then
    if [[ ! -d "$CONFIG_DIR" ]]; then
        mv "$LEGACY_CONFIG_DIR" "$CONFIG_DIR"
        echo "Migrated config directory to new location: $CONFIG_DIR" >&2
    else
        mkdir -p "$CONFIG_DIR"
        chmod 700 "$CONFIG_DIR" || true
        merge_success=true
        while read -r f; do
            [[ -f "$f" ]] || continue
            basename_f=$(basename "$f")
            if [[ ! -f "$CONFIG_DIR/$basename_f" ]]; then
                if ! cp "$f" "$CONFIG_DIR/$basename_f"; then
                    merge_success=false
                fi
            fi
        done < <(find "$LEGACY_CONFIG_DIR" -maxdepth 1 -type f)
        if $merge_success; then
            rm -rf "$LEGACY_CONFIG_DIR"
            echo "Merged config files from legacy config directory." >&2
        else
            echo "Error: Failed to merge some config files. Legacy config directory preserved at $LEGACY_CONFIG_DIR" >&2
        fi
    fi
fi

# Ensure config directory is secure
if [[ -d "$CONFIG_DIR" ]]; then
    chmod 700 "$CONFIG_DIR" || true
fi

LEGACY_FILE="$CONFIG_DIR/api_key"    # legacy single file
GEMINI_FILE="$CONFIG_DIR/gemini_api_key"
OPENAI_FILE="$CONFIG_DIR/openai_api_key"
GEMINI_MODEL_FILE="$CONFIG_DIR/gemini_model"
OPENAI_MODEL_FILE="$CONFIG_DIR/openai_model"
MODE_FILE="$CONFIG_DIR/response_mode"

# Verify dependencies
for cmd in curl jq; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required dependency '$cmd' is not installed." >&2
        exit 1
    fi
done

# Determine model selection behaviour by invocation name
invoked_name=$(basename "$0")

# Reject direct anyllm invocation
if [[ "$invoked_name" == "anyllm" ]]; then
    echo "Error: Use 'gemini' or 'chatgpt' directly, not 'anyllm'." >&2
    echo "Examples:" >&2
    echo "  gemini Tell me a joke" >&2
    echo "  chatgpt Tell me a joke" >&2
    exit 1
fi

case "$invoked_name" in
  chatgpt|chat|gpt|gpt4|gpt4o)
    model_alias="chatgpt"
    default_provider="openai"
    ;;
  *)
    model_alias="gemini"
    default_provider="gemini"
    ;;
esac

# Available models
GEMINI_MODELS=(
  "gemini-2.5-flash"
  "gemini-2.0-flash"
  "gemini-1.5-pro"
  "gemini-1.5-flash"
)

OPENAI_MODELS=(
  "gpt-4o"
  "gpt-4-turbo"
  "gpt-4"
  "gpt-3.5-turbo"
)

show_usage() {
    echo "Usage: <gemini|chatgpt> [--model MODEL] [--mode MODE] [--set-key [provider] KEY | --unset-key [provider]] [--set-model [provider]] [--set-mode [mode] | --unset-mode] <prompt>" >&2
    echo "Examples:" >&2
    echo "  gemini Tell me a joke" >&2
    echo "  chatgpt Tell me a joke" >&2
    echo "  gemini --model gemini-2.5-flash Tell me a joke" >&2
    echo "  gemini --mode minimal Tell me a joke" >&2
    echo "  gemini --set-key YOUR_KEY              # sets Gemini key" >&2
    echo "  gemini --set-key openai YOUR_OPENAI_KEY" >&2
    echo "  gemini --set-model                     # interactive: pick default Gemini model" >&2
    echo "  gemini --set-model openai              # interactive: pick default OpenAI model" >&2
    echo "  gemini --set-mode                      # interactive: pick default response mode" >&2
}

# Interactive model picker
pick_model() {
    local provider="$1"
    local -a models
    local i
    local choice
    if [[ "$provider" == "openai" ]]; then
        models=("${OPENAI_MODELS[@]}")
    else
        models=("${GEMINI_MODELS[@]}")
    fi
    
    echo "Available $provider models:" >&2
    for i in "${!models[@]}"; do
        echo "  $((i+1))) ${models[$i]}" >&2
    done
    echo -n "Select model (1-${#models[@]}): " >&2
    read -r choice
    
    if [[ "$choice" =~ ^[0-9]+$ && $choice -ge 1 && $choice -le ${#models[@]} ]]; then
        echo "${models[$((choice-1))]}"
    else
        echo "Invalid selection" >&2
        return 1
    fi
}

# Helper to write a key file
save_key() {
    local provider="$1"
    local key="$2"
    local file
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR" || true
    case "$provider" in
      openai)
        file="$OPENAI_FILE" ;;
      gemini|*)
        file="$GEMINI_FILE" ;;
    esac
    (umask 077; touch "$file")
    chmod 600 "$file"
    printf "%s" "$key" > "$file"
}

# Helper to remove a key file
remove_key() {
    local provider="$1"
    case "$provider" in
      openai) rm -f "$OPENAI_FILE" ;;
      gemini|*) rm -f "$GEMINI_FILE" ;;
    esac
}

# Helper to save model preference
save_model() {
    local provider="$1"
    local model="$2"
    local file
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR" || true
    case "$provider" in
      openai)
        file="$OPENAI_MODEL_FILE" ;;
      gemini|*)
        file="$GEMINI_MODEL_FILE" ;;
    esac
    (umask 077; touch "$file")
    chmod 600 "$file"
    printf "%s" "$model" > "$file"
}

# Helper to remove model preference
remove_model() {
    local provider="$1"
    case "$provider" in
      openai) rm -f "$OPENAI_MODEL_FILE" ;;
      gemini|*) rm -f "$GEMINI_MODEL_FILE" ;;
    esac
}

# Interactive mode picker
pick_mode() {
    local -a modes=("default" "minimal" "code")
    local i
    local choice
    echo "Available response modes:" >&2
    for i in "${!modes[@]}"; do
        echo "  $((i+1))) ${modes[$i]}" >&2
    done
    echo -n "Select mode (1-${#modes[@]}): " >&2
    read -r choice
    
    if [[ "$choice" =~ ^[0-9]+$ && $choice -ge 1 && $choice -le ${#modes[@]} ]]; then
        echo "${modes[$((choice-1))]}"
    else
        echo "Invalid selection" >&2
        return 1
    fi
}

# Helper to write response mode preference
save_mode_pref() {
    local mode="$1"
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR" || true
    (umask 077; printf "%s" "$mode" > "$MODE_FILE")
    chmod 600 "$MODE_FILE"
}

# Helper to remove response mode preference
remove_mode_pref() {
    rm -f "$MODE_FILE"
}

# Handle help command
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    show_usage
    exit 0
fi

# Handle set/unset key commands
if [[ "$1" == "--set-key" ]]; then
    # support: --set-key KEY  (legacy -> gemini)
    # or: --set-key provider KEY
    if [[ "$2" == "openai" || "$2" == "gemini" ]]; then
        provider="$2"; key="$3"
    else
        provider="$default_provider"; key="$2"
    fi
    if [[ -z "$key" ]]; then
        echo "Usage: --set-key [provider] YOUR_API_KEY" >&2
        exit 1
    fi
    save_key "$provider" "$key"
    echo "API key saved for $provider"
    exit 0
fi

if [[ "$1" == "--unset-key" ]]; then
    if [[ "$2" == "openai" || "$2" == "gemini" ]]; then
        provider="$2"
    else
        provider="$default_provider"
    fi
    remove_key "$provider"
    echo "API key removed for $provider"
    exit 0
fi

# Handle set/unset model commands
if [[ "$1" == "--set-model" ]]; then
    if [[ "$2" == "openai" || "$2" == "gemini" ]]; then
        provider="$2"
    else
        provider="$default_provider"
    fi
    model=$(pick_model "$provider")
    if [[ $? -eq 0 && -n "$model" ]]; then
        save_model "$provider" "$model"
        echo "Default $provider model set to: $model"
        exit 0
    else
        exit 1
    fi
fi

if [[ "$1" == "--unset-model" ]]; then
    if [[ "$2" == "openai" || "$2" == "gemini" ]]; then
        provider="$2"
    else
        provider="$default_provider"
    fi
    remove_model "$provider"
    echo "Default $provider model reset"
    exit 0
fi

# Handle set/unset response mode commands
if [[ "$1" == "--set-mode" ]]; then
    if [[ "$2" == "default" || "$2" == "minimal" || "$2" == "code" ]]; then
        mode="$2"
    elif [[ -n "$2" ]]; then
        echo "Error: Invalid mode '$2'. Available modes: default, minimal, code" >&2
        exit 1
    else
        mode=$(pick_mode)
        if [[ $? -ne 0 || -z "$mode" ]]; then
            exit 1
        fi
    fi
    save_mode_pref "$mode"
    echo "Default response mode set to: $mode"
    exit 0
fi

if [[ "$1" == "--unset-mode" ]]; then
    remove_mode_pref
    echo "Default response mode reset to default"
    exit 0
fi

# Migrate legacy API key file if it exists
if [[ -f "$LEGACY_FILE" ]]; then
    legacy_key=$(cat "$LEGACY_FILE")
    if [[ -n "$legacy_key" ]]; then
        if save_key "gemini" "$legacy_key"; then
            rm -f "$LEGACY_FILE"
            echo "Migrated legacy API key to new location: $GEMINI_FILE" >&2
        fi
    fi
fi

# Load keys (env overrides files)
if [[ -z "$GEMINI_API_KEY" && -f "$GEMINI_FILE" ]]; then
    export GEMINI_API_KEY=$(cat "$GEMINI_FILE")
fi

if [[ -z "$OPENAI_API_KEY" && -f "$OPENAI_FILE" ]]; then
    export OPENAI_API_KEY=$(cat "$OPENAI_FILE")
fi

# Load stored model preferences
if [[ -f "$GEMINI_MODEL_FILE" ]]; then
    stored_gemini_model=$(cat "$GEMINI_MODEL_FILE")
fi

if [[ -f "$OPENAI_MODEL_FILE" ]]; then
    stored_openai_model=$(cat "$OPENAI_MODEL_FILE")
fi

# Load stored response mode preference
stored_response_mode="default"
if [[ -f "$MODE_FILE" ]]; then
    stored_response_mode=$(cat "$MODE_FILE")
fi

# Parse command line options loop
while [[ "$1" == --* ]]; do
    if [[ "$1" == "--model" ]]; then
        model_override="$2"
        shift 2
    elif [[ "$1" == "--mode" ]]; then
        mode_override="$2"
        shift 2
    else
        break
    fi
done

# Handle help command if passed after options
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    show_usage
    exit 0
fi

# Allow model alias as first arg (e.g., `gemini chatgpt Tell me a joke`)
case "$1" in
  chatgpt|chat|gpt|gpt4|gpt4o)
    model_alias="chatgpt"; shift ;;
  gemini|gemini-2.5-flash)
    model_alias="gemini"; shift ;;
esac

# Apply model override if provided
if [[ -n "$model_override" ]]; then
    # if override looks like an openai model (starts with gpt) use chatgpt path
    if [[ "$model_override" == gpt* || "$model_override" == chat* ]]; then
        model_alias="chatgpt"
        openai_model="$model_override"
    else
        model_alias="gemini"
        google_model="$model_override"
    fi
fi

# Final model defaults (prefer stored preferences, then hard defaults)
if [[ -z "$google_model" ]]; then
    google_model="${stored_gemini_model:-gemini-2.5-flash}"
fi
if [[ -z "$openai_model" ]]; then
    openai_model="${stored_openai_model:-gpt-4o}"
fi

# Check for prompt
if [[ -z "$1" ]]; then
    show_usage
    exit 1
fi

prompt="$*"

echo -n "Thinking..." >&2

# Resolve final response mode
response_mode="${mode_override:-$stored_response_mode}"
if [[ "$response_mode" != "default" && "$response_mode" != "minimal" && "$response_mode" != "code" ]]; then
    echo "Error: Invalid response mode '$response_mode'. Available modes: default, minimal, code" >&2
    exit 1
fi

system_prompt=""
case "$response_mode" in
  minimal)
    system_prompt="Provide extremely concise, direct answers. Avoid any conversational filler, introductory remarks, or postscripts."
    ;;
  code)
    system_prompt="Provide only clean, executable code or structured format. Do not wrap code in markdown code fences unless explicitly requested. Avoid any explanation or commentary."
    ;;
esac

# Prepare API call details
if [[ "$model_alias" == "gemini" ]]; then
    if [[ -z "$GEMINI_API_KEY" ]]; then
        echo "Error: GEMINI_API_KEY not set for Gemini model." >&2
        echo "Set it with: anyllm --set-key YOUR_KEY" >&2
        exit 1
    fi
    url="https://generativelanguage.googleapis.com/v1beta/models/${google_model}:streamGenerateContent?alt=sse&key=${GEMINI_API_KEY}"
    if [[ -n "$system_prompt" ]]; then
        payload=$(jq -n --arg p "$prompt" --arg sys "$system_prompt" '{contents: [{parts: [{text: $p}]}], systemInstruction: {parts: [{text: $sys}]}}')
    else
        payload=$(jq -n --arg p "$prompt" '{contents: [{parts: [{text: $p}]}]}')
    fi
    auth_header=""
else
    # chatgpt / OpenAI path
    if [[ -z "$OPENAI_API_KEY" ]]; then
        echo "Error: OPENAI_API_KEY not set for ChatGPT model." >&2
        echo "Set it with: anyllm --set-key openai YOUR_OPENAI_KEY" >&2
        exit 1
    fi
    url="https://api.openai.com/v1/chat/completions"
    if [[ -n "$system_prompt" ]]; then
        payload=$(jq -n --arg m "$openai_model" --arg p "$prompt" --arg sys "$system_prompt" '{model: $m, messages: [{role: "system", content: $sys}, {role: "user", content: $p}], stream: true}')
    else
        payload=$(jq -n --arg m "$openai_model" --arg p "$prompt" '{model: $m, messages: [{role: "user", content: $p}], stream: true}')
    fi
    auth_header="Authorization: Bearer ${OPENAI_API_KEY}"
fi

# Prepare curl command array
curl_args=(-sS -N -X POST "$url" -H "Content-Type: application/json" -d "$payload")
if [[ -n "$auth_header" ]]; then
    curl_args+=(-H "$auth_header")
fi

# Stream response and process output
first_line=true
is_error=false
error_buffer=""
thinking_cleared=false

status_file=$(mktemp)
trap 'rm -f "$status_file"' EXIT INT TERM

while read -r line || [[ -n "$line" ]]; do
    # Strip trailing carriage return (\r)
    line="${line%$'\r'}"
    
    # Determine if the response is an error JSON payload on the first line
    if $first_line; then
        first_line=false
        if [[ "$line" =~ ^[[:space:]]*\{ ]]; then
            is_error=true
        fi
    fi
    
    if $is_error; then
        error_buffer+="$line"$'\n'
    else
        # Process SSE data line
        if [[ "$line" == data:* ]]; then
            data="${line#data:}"
            data="${data# }"
            if [[ "$data" == "[DONE]" ]]; then
                break
            fi
            
            # Extract content chunk text
            if [[ "$model_alias" == "gemini" ]]; then
                content=$(printf '%s\n' "$data" | jq -r '.candidates[0].content.parts[0].text // empty' 2>/dev/null)
            else
                content=$(printf '%s\n' "$data" | jq -r '.choices[0].delta.content // empty' 2>/dev/null)
            fi
            
            # Print chunk immediately if not empty
            if [[ -n "$content" ]]; then
                if ! $thinking_cleared; then
                    # Clear "Thinking..."
                    printf "\r\033[K" >&2
                    thinking_cleared=true
                fi
                printf "%s" "$content"
            fi
        fi
    fi
done < <(curl "${curl_args[@]}"; echo $? > "$status_file")

# Ensure "Thinking..." is cleared if it wasn't cleared during streaming
if ! $thinking_cleared; then
    printf "\r\033[K" >&2
fi

# Check curl exit status
if [[ -f "$status_file" ]]; then
    curl_exit=$(cat "$status_file")
    rm -f "$status_file"
    trap - EXIT INT TERM
    if [[ "$curl_exit" -ne 0 ]]; then
        echo "Error: Network request failed with curl exit code $curl_exit" >&2
        exit "$curl_exit"
    fi
fi

# Handle errors if any occurred
if $is_error; then
    if [[ "$model_alias" == "gemini" ]]; then
        error_msg=$(printf '%s\n' "$error_buffer" | jq -r '.error.message // .message // "Unknown Gemini Error"' 2>/dev/null)
    else
        error_msg=$(printf '%s\n' "$error_buffer" | jq -r '.error.message // .message // "Unknown OpenAI Error"' 2>/dev/null)
    fi
    echo "Error: $error_msg" >&2
    exit 1
fi

# Print a trailing newline for normal response
printf "\n"
