echo -n "Thinking..." >&2
#!/usr/bin/env zsh

# Config location (XDG or fallback)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gemini-cli"
CONFIG_FILE="$CONFIG_DIR/api_key"

show_usage() {
    echo "Usage: gemini [--set-key KEY | --unset-key] <your prompt here>" >&2
}

# Handle set/unset key commands
if [[ "$1" == "--set-key" ]]; then
    key="$2"
    if [[ -z "$key" ]]; then
        echo "Usage: gemini --set-key YOUR_API_KEY" >&2
        exit 1
    fi
    mkdir -p "$CONFIG_DIR"
    printf "%s" "$key" > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    echo "API key saved to $CONFIG_FILE"
    exit 0
fi

if [[ "$1" == "--unset-key" ]]; then
    if [[ -f "$CONFIG_FILE" ]]; then
        rm -f "$CONFIG_FILE"
        echo "API key removed from $CONFIG_FILE"
        exit 0
    else
        echo "No API key set." >&2
        exit 1
    fi
fi

# If GEMINI_API_KEY not set, try reading from config file
if [[ -z "$GEMINI_API_KEY" && -f "$CONFIG_FILE" ]]; then
    export GEMINI_API_KEY=$(cat "$CONFIG_FILE")
fi

# Ensure the API key exists
if [[ -z "$GEMINI_API_KEY" ]]; then
    echo "Error: GEMINI_API_KEY environment variable is not set." >&2
    echo "You can set it once with: gemini --set-key YOUR_API_KEY" >&2
    exit 1
fi

# Check for arguments
if [[ -z "$1" ]]; then
    show_usage
    exit 1
fi

prompt="$*"

# Safely build the JSON payload using jq
payload=$(jq -n --arg p "$prompt" '{contents: [{parts: [{text: $p}]}]}')

echo -n "Thinking..." >&2

# Call the Gemini API
response=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$payload")

# Clear the "Thinking..." line
printf "\r\033[K" >&2

if [[ -z "$response" ]]; then
    echo "Error: No response received from the API." >&2
    exit 1
fi

# Output the parsed response
printf '%s\n' "$response" | jq -r 'if .candidates then .candidates[0].content.parts[0].text else .error.message end'
